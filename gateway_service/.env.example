# Microservices endpoints
DownloaderURL=/download
ConverterURL=/convert
TranscriberURL=/transcribe

# Gateway host and port
host=127.0.0.1
port=8000

DownloaderPort=8001
ConverterPort=8002
TranscriberPort=8003

DownloaderHost=downloader_service
ConverterHost=converter_service
TranscriberHost=transcriber_service

# File storage
UploadedFilesDir=../tmp/uploaded_files
STORAGE_TYPE=local
TOOLS_FOLDER=/tools

# MongoDB (job statuses)
mongo_url=mongodb://MONGO_USERNAME:MONGO_PASSWORD@mongo:27017/?authSource=admin
db_name=transcriber_db
collection_name=jobs

# Redis (Celery broker)
REDIS_URL=redis://redis:6379/0

# Temporary folders shared between services
DOWNLOADER_OUTPUT_DIR=../tmp/downloader_output
CONVERTER_OUTPUT_DIR=../tmp/converter_output
TRANSCRIBER_OUTPUT_DIR=../tmp/transcriber_output
UPLOADED_FILES_DIR=../tmp/uploaded_files

# Max size of an uploaded file in MB
MAX_UPLOAD_MB = 100
